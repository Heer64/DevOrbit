PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devorbit
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: old folder for profile photos uploaded before they moved to MongoDB GridFS
# (default: backend/uploads). New photos are stored in the database, not here.
# UPLOAD_DIR=
# Optional: password for the demo accounts created by `npm run seed` (default: DevOrbit@2026)
# SEED_PASSWORD=

# [Sprint 4 - M1] US-31 GitHub OAuth. Server-side only: never put these in frontend/.env.
# Register an OAuth App at https://github.com/settings/developers (see README "GitHub OAuth setup").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must equal the OAuth App's "Authorization callback URL" exactly.
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# 64 hex characters used to encrypt stored GitHub tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_KEY=

# [Sprint 4 - M4] US-34 GitHub webhooks (commits, issues, pull requests -> Activity feed). Server-side only.
# Shared secret GitHub signs every delivery with (X-Hub-Signature-256). At least 20 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=
# Public URL GitHub delivers to: <public API URL>/api/github/webhook. GitHub cannot reach localhost,
# so locally use a smee.io channel or an ngrok URL (see README "Sprint 4 — M4").
GITHUB_WEBHOOK_URL=

# [Sprint 6 - M1] D1 fix: how many proxies sit in front of the API, so rate limits see each user's real IP.
# Leave unset (or false) when nothing is in front of the API (plain local development).
# Render (deployed API): TRUST_PROXY=1
# Local testing with smee-client / ngrok on the same machine: TRUST_PROXY=loopback
# "true" is refused (any client could fake its IP). See README "Sprint 6 — M1".
# TRUST_PROXY=

# [Sprint 6 - M3] US-41 AI Copilot: the shared LLM client (also used by M4 Copilot answers and M5 Catch Me Up).
# Server-side only: never put the key in frontend/.env. Leave LLM_API_KEY empty to run without AI: the Copilot
# then shows "AI temporarily unavailable" and chat, tasks and feeds work as usual. See README "Sprint 6 — M3".
# anthropic (Claude, default) or openai (OpenAI, or any OpenAI-compatible API through LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Default for anthropic: claude-haiku-5-5. Required for openai: the model ID from your provider's docs.
# LLM_MODEL=
# Only for an OpenAI-compatible provider other than OpenAI (must be https://). Default https://api.openai.com/v1
# LLM_BASE_URL=
# Give up after this many milliseconds (1000-60000, default 15000). The answer is then "AI temporarily unavailable".
# LLM_TIMEOUT_MS=15000
# Longest answer, in tokens (50-4000, default 500). Shorter answers come back faster.
# LLM_MAX_OUTPUT_TOKENS=500

# [Sprint 6 - M4] US-42 Copilot answers grounded in project data. Each request (system prompt + project records +
# question) stays within this many input tokens: 8000 (the user-story limit) unless set lower here (2000-8000).
# Records that do not fit are left out, least related and oldest first. See README "Sprint 6 — M4".
# COPILOT_MAX_INPUT_TOKENS=8000
