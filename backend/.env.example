PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devorbit
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: where uploaded profile photos are stored (default: backend/uploads)
# UPLOAD_DIR=

# [Sprint 4 - M1] US-31 GitHub OAuth. Server-side only: never put these in frontend/.env.
# Register an OAuth App at https://github.com/settings/developers (see README "GitHub OAuth setup").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must equal the OAuth App's "Authorization callback URL" exactly.
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# 64 hex characters used to encrypt stored GitHub tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_KEY=
